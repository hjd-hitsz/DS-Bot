# Host port and bind address of the Docker Web service.
DS_BOT_BIND=127.0.0.1
DS_BOT_PORT=13080
DSH_TRUSTED_HOST=localhost,127.0.0.1

# Optional. Other native providers can be configured in Settings → Models.
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://your-messages-endpoint.example

# Optional overrides.
# PUID=1000
# PGID=1000
# DSH_TELEMETRY_DISABLED=1
# NPM_REGISTRY=https://registry.npmjs.org/
# DSH_VERSION=0.2.2-rc.1
